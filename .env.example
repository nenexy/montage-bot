# Токен бота от @BotFather
BOT_TOKEN=
# Модель распознавания: tiny / base / small / medium / large-v3 (точнее = медленнее)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
LANGUAGE=ru
# Максимальная длина видео, секунд
MAX_DURATION=300
# Сколько роликов монтировать одновременно
WORKERS=1
# Шрифт субтитров (на Linux положи .ttf в assets/fonts или укажи папку)
SUB_FONT=Arial
SUB_FONTS_DIR=
# Свой Bot API сервер (снимает лимит 20 МБ на скачивание), напр. http://localhost:8081
TELEGRAM_API_URL=

# --- Оплата ЮKassa (пусто = бот бесплатный) ---
# Токен из @BotFather → /mybots → бот → Payments → ЮKassa (тестовый содержит :TEST:)
PAYMENT_PROVIDER_TOKEN=
# Пакеты «роликов:цена в рублях» через запятую (минимум ~60 ₽ за платёж)
PACKS=1:99,5:399,20:1290
# Сколько роликов дарить новому пользователю
FREE_VIDEOS=1
# 1 = спрашивать e-mail и передавать в ЮKassa данные для чека 54-ФЗ
YOOKASSA_RECEIPT=0
# Telegram id админов через запятую (команда /stats)
ADMIN_IDS=
# Контакт поддержки для /paysupport, напр. @username
SUPPORT_CONTACT=
